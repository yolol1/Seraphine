/* Career Interface — Light Theme */
QLabel {
    color: rgba(0, 0, 0, 0.85);
    font: 14px 'Microsoft YaHei UI', 'Segoe UI';
}

QLabel#name {
    color: rgba(0, 0, 0, 0.9);
    font: bold 28px 'Microsoft YaHei UI', 'Segoe UI';
    letter-spacing: -0.3px;
}

QLabel#tagLineLabel {
    font: 14px;
    color: rgba(0, 0, 0, 0.5);
}

QLabel#rencent20GamesLabel,
QLabel#winsLabel,
QLabel#lossesLabel,
QLabel#kdaLabel,
QLabel#kdaValLabel {
    color: rgba(0, 0, 0, 0.8);
    font: 14px 'Microsoft YaHei UI', 'Segoe UI';
}

QLabel#winsLabel,
QLabel#lossesLabel {
    font: bold 14px;
}

QLabel#totalLabel {
    font: bold 14px;
    color: --ThemeColorPrimary;
}

PushButton#careerActionButton {
    color: rgba(0, 0, 0, 0.74);
    background-color: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 8px;
    padding: 0 12px;
    font: 13px 'Microsoft YaHei UI', 'Segoe UI';
}

PushButton#careerActionButton:hover {
    color: rgba(0, 0, 0, 0.9);
    background-color: rgba(255, 255, 255, 0.94);
    border-color: rgba(0, 0, 0, 0.16);
}

PushButton#careerActionButton:pressed {
    background-color: rgba(0, 0, 0, 0.06);
}

PushButton#copySummonerNameButton {
    color: rgba(0, 0, 0, 0.74);
    background-color: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 6px;
    padding: 0 10px;
    font: 12px 'Microsoft YaHei UI', 'Segoe UI';
}

PushButton#copySummonerNameButton:hover {
    color: rgba(0, 0, 0, 0.9);
    background-color: rgba(255, 255, 255, 0.94);
}

#gameInfoArea {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.03);
}

#gameInfoWidget {
    background: transparent;
}

GameInfoBar {
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

GameInfoBar:hover {
    background-color: rgba(0, 0, 0, 0.04);
}

GameInfoBar>QLabel {
    color: rgba(0, 0, 0, 0.8);
    background: transparent;
    font: 14px 'Microsoft YaHei UI', 'Segoe UI';
}

ItemsKdaCsGold>QLabel {
    font: 15px 'Microsoft YaHei UI', 'Segoe UI';
}

ItemsKdaCsGold>#kills,
ItemsKdaCsGold>#deaths,
ItemsKdaCsGold>#assists,
ItemsKdaCsGold>#slash1,
ItemsKdaCsGold>#slash2 {
    font: bold 15px 'Microsoft YaHei UI', 'Segoe UI';
}

ResultModeSpell>ColorLabel {
    font: bold 16px 'Microsoft YaHei UI', 'Segoe UI';
}

CareerInterface {
    border: none;
    background-color: #fafafa;
}

#careerViewport {
    border: none;
    background-color: transparent;
}

TeammateInfoBar {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
}

TeammateInfoBar:hover {
    background-color: rgba(0, 0, 0, 0.03);
}

TeammateInfoBar>#winsLabel,
TeammateInfoBar>#lossesLabel {
    font: bold;
}

SummonerName {
    font: bold 14px 'Microsoft YaHei UI', 'Segoe UI';
    text-align: center;
    padding: 4px 8px 4px 8px;
    color: rgba(0, 0, 0, 0.8);
    border: none;
    background-color: transparent;
}

SummonerName:hover {
    color: --ThemeColorDark1;
}

SummonerName[pressed=true] {
    color: --ThemeColorDark3;
}
