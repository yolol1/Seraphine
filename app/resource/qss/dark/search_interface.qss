SearchInterface {
    border: none;
    background-color: transparent;
}

GamesView {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.051);
}

GamesTab {
    /* border-right: 1px solid rgb(230, 230, 230); */
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-right: 1px solid rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.051);
}

GamesTab>QLabel {
    color: rgba(255, 255, 255, 0.95);
    font: 14px 'Segoe UI', 'Microsoft YaHei';
}

#emptyLabel {
    color: rgba(255, 255, 255, 0.95);
    font: 14px 'Segoe UI', 'Microsoft YaHei';
}

GameTab {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

GameTab[selected=true] {
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.3);
}

GameTab>QLabel {
    color: rgba(255, 255, 255, 0.95);
    font: 14px 'Segoe UI', 'Microsoft YaHei';
}

GameTab>#time {
    font: 12px;
    color: rgba(255, 255, 255, 0.6);
}

GameTab>#kills {
    font: 12px;
    color: rgba(255, 255, 255, 0.6);
}

GameTab>#slash1 {
    font: 12px;
    color: rgba(255, 255, 255, 0.35);
}

GameTab>#deaths {
    font: 12px;
    color: rgba(255, 255, 255, 0.6);
}

GameTab>#slash2 {
    font: 12px;
    color: rgba(255, 255, 255, 0.35);
}

GameTab>#assists {
    font: 12px;
    color: rgba(255, 255, 255, 0.6);
}

GameDetailView {
    /* border-left: 1px solid rgb(230, 230, 230);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px; */
    background-color: transparent;
}

GameTitleBar>#resultLabel {
    color: rgba(255, 255, 255, 0.95);
    font: bold 28px 'Segoe UI', 'Microsoft YaHei';
}

GameTitleBar>#infoLabel {
    color: rgba(255, 255, 255, 0.6);
    font: 12px 'Segoe UI', 'Microsoft YaHei';
}

GameTitleBar {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.051);
}

PushButton#copyGameIdButton {
    color: rgba(255, 255, 255, 0.86);
    background-color: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 0 12px;
    font: 12px 'Microsoft YaHei UI', 'Segoe UI';
}

PushButton#copyGameIdButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.22);
}

TeamView {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.051);
}

TeamView>#titleBarWidget>QLabel {
    font: 14px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(255, 255, 255, 0.95);
}

#titleBarWidget>#teamResult {
    font: bold 18px 'Segoe UI', 'Microsoft YaHei';
    padding-left: 1px;
}

#titleBarWidget>#dmgIconLabel {
    font: bold 14px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(255, 255, 255, 0.6);
}

#titleBarWidget {
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: none;
    /* border-bottom: none; */
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

SummonerInfoBar>QLabel {
    font: 14px 'Segoe UI', 'Microsoft YaHei';
    color: rgba(255, 255, 255, 0.95);
}

SummonerInfoBar {
    border: none;
    border-radius: 8px;
    background-color: transparent;
}

SummonerInfoBar>#levelLabel {
    color: rgba(255, 255, 255, 0.95);
    font: 14px 'Segoe UI', 'Microsoft YaHei';
}

SummonerInfoBar#currentSummonerWidget>QLabel {
    font: bold 14px 'Segoe UI', 'Microsoft YaHei';
    color: --ThemeColorDark2;
}

SummonerInfoBar[current=true] {
    background-color: rgba(255, 255, 255, 0.07);
}

#separator {
    color: rgba(255, 255, 255, 0.15);
}

SummonerName {
    font: 14px 'Segoe UI', 'Microsoft YaHei', 'PingFang SC';
    text-align: left;
    padding: 0px 6px 2px 6px;
    color: rgba(255, 255, 255, 0.95);
    border: none;
    background-color: transparent;
}

#gameScrollArea {
    border: none;
    background: transparent;
}

#scrollWidget {
    border: none;
    background: transparent;
}

SummonerName:hover {
    color: --ThemeColorDark1;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

SummonerName[pressed=true] {
    color: --ThemeColorDark3;
    background-color: rgba(255, 255, 255, 0.08);
}

SummonerName:disabled {
    color: rgba(255, 255, 255, 0.43);
    background-color: transparent;
}

SummonerInfoBar#currentSummonerWidget>SummonerName {
    font: bold;
    color: --ThemeColorDark2;
}

SummonerInfoBar#currentSummonerWidget>SummonerName:hover {
    font: bold;
    color: --ThemeColorDark1;
}

SummonerInfoBar#currentSummonerWidget>SummonerName[pressed=true] {
    font: bold;
    color: --ThemeColorDark3;
}

/* ── Post-game analysis ─────────────────────────────────────
   Uses the same translucent card language as GameDetailView. */

#analysisPage,
#analysisContent,
#analysisViewport,
#analysisTabShell,
#analysisOverview,
QScrollArea#analysisScrollArea {
    background: transparent;
    border: none;
}

QFrame#analysisHeader {
    background-color: rgba(255, 255, 255, 0.051);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
}

QFrame[analysisCard=true] {
    background-color: rgba(255, 255, 255, 0.051);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
}

QFrame[analysisSubpanel=true] {
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
}

QFrame[analysisTeamHeader=true] {
    background: transparent;
    border: none;
}

QFrame[analysisRow=true] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

QFrame[analysisRow=true]:hover {
    background-color: rgba(255, 255, 255, 0.045);
    border-color: rgba(255, 255, 255, 0.07);
}

QFrame[analysisTableRow=true] {
    background: transparent;
    border: none;
    border-radius: 6px;
}

QFrame[analysisTableRow=true][analysisAlternate=true] {
    background-color: rgba(255, 255, 255, 0.035);
}

QFrame[analysisEventRow=true] {
    background-color: rgba(255, 255, 255, 0.035);
    border: none;
    border-radius: 6px;
}

QFrame#analysisDivider {
    background-color: rgba(255, 255, 255, 0.10);
    border: none;
}

QLabel[analysisRole="pageTitle"] {
    color: rgba(255, 255, 255, 0.95);
    font: bold 20px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="sectionTitle"] {
    color: rgba(255, 255, 255, 0.95);
    font: bold 16px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="teamTitle"] {
    font: bold 15px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="teamTitle"][analysisTeam="blue"] {
    color: #2EA7FF;
}

QLabel[analysisRole="teamTitle"][analysisTeam="red"] {
    color: #E6525B;
}

QLabel[analysisRole="bodyStrong"] {
    color: rgba(255, 255, 255, 0.95);
    font: bold 12px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="secondary"] {
    color: rgba(255, 255, 255, 0.60);
    font: 12px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="caption"] {
    color: rgba(255, 255, 255, 0.52);
    font: 11px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="captionStrong"] {
    color: rgba(255, 255, 255, 0.68);
    font: bold 11px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="hint"] {
    color: rgba(255, 255, 255, 0.40);
    font: 11px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="hintStrong"] {
    color: rgba(255, 255, 255, 0.36);
    font: bold 11px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="teamLabel"] {
    padding: 5px 4px 2px 4px;
    font: bold 12px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="teamLabel"][analysisTeam="blue"] {
    color: #2EA7FF;
}

QLabel[analysisRole="teamLabel"][analysisTeam="red"] {
    color: #E6525B;
}

QLabel[analysisRole="teamScore"] {
    font: bold 22px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="metric"] {
    color: rgba(255, 255, 255, 0.88);
    font: bold 12px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="resultChip"] {
    padding: 2px 7px;
    border-radius: 5px;
    font: bold 10px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="resultChip"][analysisResult="win"] {
    color: #67D994;
    background-color: rgba(46, 170, 91, 0.14);
}

QLabel[analysisRole="resultChip"][analysisResult="lose"] {
    color: #F0787F;
    background-color: rgba(230, 82, 91, 0.14);
}

QLabel[analysisRole="tableHeader"] {
    color: rgba(255, 255, 255, 0.52);
    font: bold 11px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="tableCell"] {
    color: rgba(255, 255, 255, 0.84);
    font: 12px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="time"] {
    color: rgba(255, 255, 255, 0.56);
    font: bold 12px Consolas, monospace;
}

QLabel[analysisRole="eventText"] {
    font: 12px 'Segoe UI', 'Microsoft YaHei';
}

QLabel[analysisRole="eventText"][analysisEventTone="neutral"] {
    color: rgba(255, 255, 255, 0.76);
}

QLabel[analysisRole="eventText"][analysisEventTone="blue"] {
    color: #65B8FF;
}

QLabel[analysisRole="eventText"][analysisEventTone="red"] {
    color: #F0787F;
}

QLabel[analysisRole="eventText"][analysisEventTone="gold"] {
    color: #F5C35B;
}

QLabel[analysisRole="eventText"][analysisEventTone="positive"] {
    color: #67D994;
}

QLabel[analysisRole="secondary"][analysisTone="positive"] {
    color: #67D994;
}

QLabel[analysisRole="secondary"][analysisTone="negative"] {
    color: #F0787F;
}
