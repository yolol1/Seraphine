/* Career Interface — Dark Theme
   Apple Design principle: every spacing, timing, and alignment
   value is a deliberate choice you can defend. */

/* ── Base typography ──────────────────────────────────── */
QLabel {
    color: rgba(255, 255, 255, 0.9);
    font: 14px 'Microsoft YaHei UI', 'Segoe UI';
}

QLabel#name {
    color: white;
    font: bold 28px 'Microsoft YaHei UI', 'Segoe UI';
    letter-spacing: -0.3px;
}

QLabel#tagLineLabel {
    font: 14px;
    color: rgba(255, 255, 255, 0.6);
}

QLabel#rencent20GamesLabel,
QLabel#winsLabel,
QLabel#lossesLabel,
QLabel#kdaLabel,
QLabel#kdaValLabel {
    color: rgba(255, 255, 255, 0.85);
    font: 14px 'Microsoft YaHei UI', 'Segoe UI';
}

QLabel#winsLabel {
    font: bold 14px;
}

QLabel#lossesLabel {
    font: bold 14px;
}

QLabel#totalLabel {
    font: bold 14px;
    color: --ThemeColorPrimary;
}

PushButton#careerActionButton {
    color: rgba(255, 255, 255, 0.84);
    background-color: rgba(255, 255, 255, 0.075);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    padding: 0 12px;
    font: 13px 'Microsoft YaHei UI', 'Segoe UI';
}

PushButton#careerActionButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.18);
}

PushButton#careerActionButton:pressed {
    background-color: rgba(255, 255, 255, 0.06);
}

PushButton#copySummonerNameButton {
    color: rgba(255, 255, 255, 0.82);
    background-color: rgba(255, 255, 255, 0.075);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 6px;
    padding: 0 10px;
    font: 12px 'Microsoft YaHei UI', 'Segoe UI';
}

PushButton#copySummonerNameButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.13);
}

/* ── Cards and containers ─────────────────────────────── */
#gameInfoArea {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.04);
}

#gameInfoWidget {
    background: transparent;
}

GameInfoBar {
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

GameInfoBar:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

GameInfoBar>QLabel {
    color: rgba(255, 255, 255, 0.85);
    background: transparent;
    font: 14px 'Microsoft YaHei UI', 'Segoe UI';
}

/* ── KDA area ─────────────────────────────────────────── */
ItemsKdaCsGold>QLabel {
    font: 15px 'Microsoft YaHei UI', 'Segoe UI';
}

ItemsKdaCsGold>#kills,
ItemsKdaCsGold>#deaths,
ItemsKdaCsGold>#assists,
ItemsKdaCsGold>#slash1,
ItemsKdaCsGold>#slash2 {
    font: bold 15px 'Microsoft YaHei UI', 'Segoe UI';
}

/* ── Result / Mode ─────────────────────────────────────── */
ResultModeSpell>ColorLabel {
    font: bold 16px 'Microsoft YaHei UI', 'Segoe UI';
}

/* ── Career interface root ─────────────────────────────── */
CareerInterface {
    border: none;
    background-color: #202020;
}

#careerViewport {
    border: none;
    background-color: transparent;
}

/* ── Teammate info ─────────────────────────────────────── */
TeammateInfoBar {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

TeammateInfoBar:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

TeammateInfoBar>#winsLabel,
TeammateInfoBar>#lossesLabel {
    font: bold;
}

/* ── Summoner name buttons ─────────────────────────────── */
SummonerName {
    font: bold 14px 'Microsoft YaHei UI', 'Segoe UI';
    text-align: center;
    padding: 4px 8px 4px 8px;
    color: rgba(255, 255, 255, 0.9);
    border: none;
    background-color: transparent;
}

SummonerName:hover {
    color: --ThemeColorDark1;
}

SummonerName[pressed=true] {
    color: --ThemeColorDark3;
}
